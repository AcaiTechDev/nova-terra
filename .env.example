# Copie este arquivo para .env.local (não versionado) e preencha com os
# valores do seu projeto Supabase (Settings > API).
# NUNCA coloque a Service Role Key em variáveis com prefixo NEXT_PUBLIC_.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# Chaves públicas, usadas pelo painel admin (login/autenticação).
# É seguro expor essas duas no navegador — não são segredos.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-publishable-key-aqui
